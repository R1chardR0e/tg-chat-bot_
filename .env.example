# Telegram-бот
BOT_TOKEN=replace_with_telegram_bot_token
CHAT_IDS=-1001234567890

# Нужны только скриптам загрузки истории
API_ID=123456
API_HASH=replace_with_telegram_api_hash
CHAT_URL=https://t.me/example_chat

# Провайдер ответов: io_net или mistral
API_PROVIDER=io_net
API_URL=https://api.intelligence.io.solutions/api/v1/
MODEL_NAME=replace_with_model_name
IO_NET_API_KEY=replace_with_io_net_api_key
MISTRAL_API_KEY=

# Доступ к локальному HTTP API
API_ACCESS_TOKEN=replace_with_long_random_api_token

# Семантический поиск и профили
ENABLE_EMBEDDING=false
EMBEDDING_MODEL=BAAI/bge-multilingual-gemma2
EMBEDDING_DIM=3584
ENABLE_LEARNING=false

# Локальные данные
DB_PATH=chat.db
VECTOR_DB_PATH=chat_embeddings.index

# Контекст и поиск
TIME_WINDOW_HOURS=24
TOPIC_TOP_K=5
RECENT_TOP_K=10
MAX_DEPTH=10

# Логирование
LOG_LEVEL=INFO
